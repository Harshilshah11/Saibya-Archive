# Server config. Locally: copy to .env.local. On EC2: /opt/saibya/app/.env.production.
# With S3_BUCKET empty the API serves generated demo data.

# Bucket written by cloud_sync on the Jetson
S3_BUCKET=arnobot-saibya-data
S3_REGION=ap-south-1

# Only for local runs: on EC2 leave both empty, credentials come from the instance's IAM role.
# Never commit real keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Postgres index (on EC2: the local Postgres). Empty = list S3 directly.
# After setting it: npm run db:migrate, npm run robot:add -- saibya02
DATABASE_URL=

# v3: bearer token for POST /api/admin/reindex (rebuild the index from S3). 32+ random bytes, hex.
ADMIN_TOKEN=

# Optional: fixed robot list instead of discovering top-level prefixes (e.g. saibya01,saibya02)
ROBOT_IDS=

# v4: largest file PUT /api/ingest/upload accepts (MB); bigger bodies get 413
UPLOAD_MAX_MB=100

# How long presigned GET URLs stay valid (seconds)
PRESIGN_EXPIRES_SECONDS=3600

# session.json not marked ended and no upload for this long -> session shows as "interrupted"
INTERRUPTED_AFTER_MINUTES=30

# Sensor chunk length written by cloud_sync (seconds)
CHUNK_SECONDS=60

# Camera segment length when session.json has no video_segment_s (older sessions).
# The DVR records 10-minute segments; simulated cameras are 60 s and say so in session.json.
VIDEO_SEGMENT_SECONDS=600

# Robot clock offset; chunk names like 20260924_134701 are robot local time
ROBOT_UTC_OFFSET=+05:30

# Force demo data even when S3_BUCKET is set
# DEMO_MODE=1
